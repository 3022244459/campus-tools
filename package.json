{
  "name": "campus-tools",
  "private": true,
  "version": "0.1.0",
  "description": "校园工具 App 试点基础版",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:web": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "node --watch --experimental-sqlite --experimental-strip-types server/index.ts",
    "start:api": "node --experimental-sqlite --experimental-strip-types server/index.ts",
    "build": "vite build",
    "build:android": "npm run build && npx cap sync android",
    "build:android:release": "npm run check && npm run build && npx cap sync android && node scripts/check-java.mjs 17 && android\\gradlew.bat -p android assembleRelease",
    "cap:sync": "npx cap sync",
    "android": "npx cap open android",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit",
    "lint:server": "tsc --project tsconfig.server.json --noEmit",
    "db:migrate": "node --experimental-sqlite --experimental-strip-types server/scripts/migrate.ts",
    "db:seed": "node --experimental-sqlite --experimental-strip-types server/scripts/seed.ts",
    "db:backup": "node --experimental-sqlite --experimental-strip-types server/scripts/backup.ts",
    "db:restore": "node --experimental-sqlite --experimental-strip-types server/scripts/restore.ts",
    "test:server": "node --experimental-strip-types server/tests/run.ts",
    "check": "npm run lint && npm run lint:server && npm run test:server",
    "verify:pilot": "node --experimental-sqlite --experimental-strip-types server/scripts/verify-pilot.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
