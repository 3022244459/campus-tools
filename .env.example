# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# API_PORT: Local Express API port
API_PORT="8787"

# APP_ENV: development, test, staging, pilot, or production.
# staging/pilot/production enforce explicit CORS, disabled mock fallback, and DATA_STORE=sqlite.
APP_ENV="development"

# DATA_STORE: json keeps the legacy file store; sqlite uses server/data/campus.sqlite
DATA_STORE="json"
SQLITE_DB_FILE="server/data/campus.sqlite"

# BACKUP_DIR: Local directory for npm.cmd run db:backup output. Keep generated backups out of git.
BACKUP_DIR="server/backups"

# VITE_API_PROXY_TARGET: Vite dev proxy target for /api requests
VITE_API_PROXY_TARGET="http://127.0.0.1:8787"

# VITE_API_BASE_URL: Explicit API base URL for web/Capacitor builds when needed
VITE_API_BASE_URL="/api"

# VITE_ENABLE_MOCK_FALLBACK: keep true for local demos; set false for pilot/staging/production
VITE_ENABLE_MOCK_FALLBACK="true"

# VITE_SHOW_DEMO_CREDENTIALS: only true for local demos; staging/pilot/production must keep this false/empty
VITE_SHOW_DEMO_CREDENTIALS="true"

# CORS_ORIGINS: Comma-separated browser origins allowed to call the local API
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost,http://localhost"

# TRUST_PROXY: false for direct local API; set loopback/1/true behind a controlled reverse proxy
TRUST_PROXY="false"

# RATE_LIMIT_WINDOW_MS / RATE_LIMIT_MAX_REQUESTS: In-memory API rate limit for the local pilot server
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="120"

# REQUEST_BODY_LIMIT: Maximum JSON request body accepted by the Express API
REQUEST_BODY_LIMIT="100kb"

# SESSION_TTL_HOURS: Login session lifetime before token expiration
SESSION_TTL_HOURS="168"

# LOG_MAX_BYTES: Rotate server/logs/server.log when the next write would exceed this size
LOG_MAX_BYTES="5000000"

# Optional sanitized failure alert webhook. Leave empty until an external alert provider is provisioned.
ALERT_WEBHOOK_URL=""
ALERT_MIN_STATUS_CODE="500"

# Android release signing. Do not commit real values.
ANDROID_KEYSTORE_PATH=""
ANDROID_KEYSTORE_PASSWORD=""
ANDROID_KEY_ALIAS=""
ANDROID_KEY_PASSWORD=""
