# Pilot deployment template. Copy to the environment manager or a local .env file used by the API host.
# Do not commit real domains, webhook URLs, Android signing material, SMS, payment, or SSO secrets.

APP_URL="https://campus.example.edu"
API_PORT="8787"
APP_ENV="pilot"

# Pilot and production-like environments must use sqlite until PostgreSQL support is implemented.
DATA_STORE="sqlite"
SQLITE_DB_FILE="server/data/campus.sqlite"
BACKUP_DIR="server/backups"

# Replace the HTTPS origin with the real pilot domain before deployment.
CORS_ORIGINS="https://campus.example.edu,capacitor://localhost"

# The API is expected to run behind a controlled local HTTPS gateway/reverse proxy.
TRUST_PROXY="loopback"

RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="120"
REQUEST_BODY_LIMIT="100kb"
SESSION_TTL_HOURS="168"
LOG_MAX_BYTES="5000000"

# Web/Capacitor build config. Mock and demo credentials must stay disabled for pilot.
VITE_API_PROXY_TARGET="http://127.0.0.1:8787"
VITE_API_BASE_URL="https://campus.example.edu/api"
VITE_ENABLE_MOCK_FALLBACK="false"
VITE_SHOW_DEMO_CREDENTIALS="false"

# Optional sanitized alert webhook. Must be HTTPS when set in pilot/production.
ALERT_WEBHOOK_URL=""
ALERT_MIN_STATUS_CODE="500"

# Android release signing placeholders. Inject real values from a protected secret store only.
ANDROID_KEYSTORE_PATH=""
ANDROID_KEYSTORE_PASSWORD=""
ANDROID_KEY_ALIAS=""
ANDROID_KEY_PASSWORD=""
